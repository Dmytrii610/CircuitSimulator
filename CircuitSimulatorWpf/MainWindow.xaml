<Window x:Class="CircuitSimulatorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:CircuitSimulatorWpf.Services"
        Title="Circuit Simulator" Height="600" Width="900">
    <Window.Resources>
        <local:StringToResourceConverter x:Key="StringToResourceConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lewa strona: paleta -->
        <ScrollViewer Grid.Column="0">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded}">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="4" MouseMove="PaletteItem_MouseMove">
                                            <svgc:SvgViewbox Source="{Binding IconPath}" Width="32" Height="32"/>
                                            <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Prawa strona: pole symulacji -->
        <Grid Grid.Column="1">
            <ItemsControl x:Name="SimulationCanvas" Grid.Column="1"
          ItemsSource="{Binding PlacedElements}"
          AllowDrop="True" Drop="SimulationCanvas_Drop"
          Background="White">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <StackPanel Orientation="Vertical"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="CanvasElement_MouseLeftButtonDown"
                                MouseMove="CanvasElement_MouseMove"
                                MouseLeftButtonUp="CanvasElement_MouseLeftButtonUp">
                                    <svgc:SvgViewbox Source="{Binding IconPath}" Width="40" Height="40"/>
                                    <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" FontSize="10"/>
                                    <TextBlock Text="{Binding MeasurementText}" HorizontalAlignment="Center" FontSize="10" Foreground="Blue"/>
                            </StackPanel>

                            <Ellipse Width="8" Height="8" Fill="Red" Cursor="Hand"
                        Canvas.Left="{Binding PinA.OffsetX}" Canvas.Top="{Binding PinA.OffsetY}"
                        MouseLeftButtonDown="Pin_MouseLeftButtonDown" Tag="{Binding PinA}"/>
                            <Ellipse Width="8" Height="8" Fill="Red" Cursor="Hand"
                        Canvas.Left="{Binding PinB.OffsetX}" Canvas.Top="{Binding PinB.OffsetY}"
                        MouseLeftButtonDown="Pin_MouseLeftButtonDown" Tag="{Binding PinB}"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Wires}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Line X1="{Binding P0.X}" Y1="{Binding P0.Y}" X2="{Binding P1.X}" Y2="{Binding P1.Y}"
                      Stroke="{Binding WireBrush}" StrokeThickness="2" IsHitTestVisible="False"/>

                            <Line X1="{Binding P1.X}" Y1="{Binding P1.Y}" X2="{Binding P2.X}" Y2="{Binding P2.Y}"
                      Stroke="Transparent" StrokeThickness="12" Cursor="SizeWE"
                      MouseLeftButtonDown="WireBend_MouseLeftButtonDown"
                      MouseMove="WireBend_MouseMove"
                      MouseLeftButtonUp="WireBend_MouseLeftButtonUp"/>

                            <Line X1="{Binding P1.X}" Y1="{Binding P1.Y}" X2="{Binding P2.X}" Y2="{Binding P2.Y}"
                      Stroke="{Binding WireBrush}" StrokeThickness="2" IsHitTestVisible="False"/>

                            <Line X1="{Binding P2.X}" Y1="{Binding P2.Y}" X2="{Binding P3.X}" Y2="{Binding P3.Y}"
                      Stroke="{Binding WireBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding GroundMarkers}" IsHitTestVisible="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Path Data="M6,0 L6,10 M0,14 L12,14 M2,18 L10,18 M4,22 L8,22"
                                Stroke="Black" StrokeThickness="2"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="GroundMarker_MouseLeftButtonDown"
                                MouseMove="GroundMarker_MouseMove"
                                MouseLeftButtonUp="GroundMarker_MouseLeftButtonUp"/>

                            <Ellipse Width="8" Height="8" Fill="Red" Cursor="Hand"
                             Canvas.Left="{Binding Pin.OffsetX}" Canvas.Top="{Binding Pin.OffsetY}"
                             MouseLeftButtonDown="Pin_MouseLeftButtonDown" Tag="{Binding Pin}"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Grid.Column="1"
            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                <Button Content="Symuluj" Command="{Binding StartSimulationCommand}" Margin="0,0,4,0" Padding="8,4"/>
                <Button Content="Stop" Command="{Binding StopSimulationCommand}" Padding="8,4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>